{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/leaderboard.schema.json",
  "title": "EML Hub leaderboard.json",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "integer" },
    "updated": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_wl", "eml", "metrics", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "source_wl": {
            "type": "string",
            "description": "Wolfram Language source. Multiple entries may share the same source_wl when alternative EML encodings are accepted."
          },
          "eml": { "type": "string" },
          "metrics": {
            "type": "object",
            "required": ["char_len", "eml_node_count", "max_bracket_depth"],
            "properties": {
              "char_len": { "type": "integer", "minimum": 1 },
              "eml_node_count": { "type": "integer", "minimum": 1 },
              "max_bracket_depth": { "type": "integer", "minimum": 1 }
            }
          },
          "verified": { "type": "string", "enum": ["seed", "pr", "pending"] },
          "lineage": {
            "type": "string",
            "enum": ["baseline", "community"],
            "description": "baseline = maintainer reference row; community = accepted submission. If omitted, UI treats verified=seed as baseline and pr/pending as community."
          },
          "category": {
            "type": "string",
            "description": "UI bucket for catalog layout (e.g. unary vs binary), not a strict taxonomy."
          },
          "submitter": { "type": "string" },
          "pr_url": { "type": "string", "format": "uri" },
          "compiler": { "type": "string" },
          "notes_zh": { "type": "string" },
          "notes_en": { "type": "string" },
          "rank_hint": { "type": "integer" }
        }
      }
    }
  }
}
